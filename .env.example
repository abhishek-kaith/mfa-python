# Required: run `make keys` and paste both printed values here.
DJANGO_SECRET_KEY=
FERNET_KEY=

# Core
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://mfa:mfa@db:5432/mfa
POSTGRES_USER=mfa
POSTGRES_PASSWORD=mfa
POSTGRES_DB=mfa

# Host ports (only the web port and MailHog UI are bound to the host).
WEB_PORT=8001
MAILHOG_UI_PORT=8026

# Email: defaults talk to the bundled MailHog. For production, point at a real SMTP host.
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@mfa.local

# OAuth: leave the client id/secret blank to disable that provider's button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/oauth/google/callback/
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8001/oauth/github/callback/

# Lockout and magic-link tunables.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=30
MAGIC_LINK_TTL_MINUTES=15
