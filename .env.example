# =============================================================================
# Multi-Factor Authentication System — environment configuration
#
# Copy to .env and fill in. `make keys` prints fresh values for the two
# secret keys below; paste them in.
# =============================================================================

# ---------- Core Django ----------
DJANGO_SECRET_KEY=change-me-run-make-keys
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Database (Postgres) ----------
# In dev the web container reaches the db service over the compose network;
# the URL below is correct as-is for `docker compose up`.
DATABASE_URL=postgres://mfa:mfa@db:5432/mfa
POSTGRES_USER=mfa
POSTGRES_PASSWORD=mfa
POSTGRES_DB=mfa

# ---------- Host port bindings (avoid collisions with other stacks) ----------
# The dev compose binds only the web port and the MailHog UI on the host.
# Override here if 8001 / 8026 are in use on your machine.
WEB_PORT=8001
MAILHOG_UI_PORT=8026

# ---------- Email (MailHog in dev, real SMTP in prod) ----------
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@mfa.local

# ---------- OAuth: Google ----------
# Console: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must match the value below exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/oauth/google/callback/

# ---------- OAuth: GitHub ----------
# Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Authorization callback URL must match the value below.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8001/oauth/github/callback/

# ---------- Encryption (Fernet, used to seal TOTP secrets at rest) ----------
FERNET_KEY=

# ---------- Account lockout ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=30

# ---------- Magic link ----------
MAGIC_LINK_TTL_MINUTES=15

# =============================================================================
# Production overrides (uncomment and edit when deploying with prod compose)
# =============================================================================
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=mfa.example.com
# WEB_PORT=8000
# DATABASE_URL=postgres://mfa:STRONG_PASSWORD_HERE@db:5432/mfa
# POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
# EMAIL_HOST=smtp.your-provider.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=postmaster@example.com
# EMAIL_HOST_PASSWORD=APP_PASSWORD_HERE
# DEFAULT_FROM_EMAIL=no-reply@example.com
# GOOGLE_OAUTH_REDIRECT_URI=https://mfa.example.com/oauth/google/callback/
# GITHUB_OAUTH_REDIRECT_URI=https://mfa.example.com/oauth/github/callback/
# GUNICORN_WORKERS=3
